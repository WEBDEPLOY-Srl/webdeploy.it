{
	"name": "webdeploy-it",
	"private": true,
	"version": "2.0.5",
	"type": "module",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/WEBDEPLOY-Srl/webdeploy.it.git"
	},
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "node build-tools/dev.mjs",
		"build": "node build.mjs",
		"preview": "node build-tools/serve.mjs build",
		"lint": "node build-tools/syntax.mjs",
		"typecheck": "tsc --noEmit -p jsconfig.json && tsc --noEmit -p jsconfig.browser.json",
		"check": "npm run lint && npm run typecheck",
		"test:unit": "node --test --test-isolation=none test/*.test.mjs",
		"test:e2e": "playwright test -c playwright.config.mjs",
		"test:e2e:webkit": "playwright test -c playwright.newsletter-webkit.config.mjs",
		"test:parity": "playwright test -c parity/playwright.config.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@playwright/test": "1.65.1",
		"@types/node": "26.6.6",
		"typescript": "6.0.3"
	}
}
