		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"simple-icons": "^16.36.0",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
